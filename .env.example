# ============================================================
# Moonview Medical HMS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.
# ============================================================

# ── Supabase Project ─────────────────────────────────────────
# Found at: https://supabase.com/dashboard/project/<your-project>/settings/api

# Your project's public URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon key (safe for client use when RLS is properly configured)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — bypasses RLS; keep SECRET, do NOT expose publicly.
# Required here because RLS is currently disabled for development.
# In production, configure RLS policies and switch back to the anon key,
# or move service-role calls to a secure server-side API route.
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
